{
  "cleanUrls": false,
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/insights/cold-email-isnt-dead",
      "destination": "/insights/responsible-b2b-outbound-australia/",
      "statusCode": 301
    },
    {
      "source": "/insights/cold-email-isnt-dead/:path*",
      "destination": "/insights/responsible-b2b-outbound-australia/",
      "statusCode": 301
    },
    {
      "source": "/privacy-policy.html",
      "destination": "/privacy-policy",
      "statusCode": 301
    },
    {
      "source": "/terms-of-service.html",
      "destination": "/terms-of-service",
      "statusCode": 301
    },
    {
      "source": "/index.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/:path*/index.html",
      "destination": "/:path*/",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/terms-of-service",
      "destination": "/terms-of-service.html"
    }
  ]
}
